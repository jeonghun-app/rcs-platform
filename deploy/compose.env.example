# Settings of the local compose stack (deploy/docker-compose.yml).
#
# make up copies this file to deploy/compose.env and fills in the secrets
# below with fresh random values (scripts/compose-env.sh). deploy/compose.env
# is ignored by git and by docker builds; never commit it. Edit
# deploy/compose.env, not this file, to change a setting locally.
#
# One KEY=value per line, no quotes: the file is read both by docker compose
# and by docker run --env-file (make e2e-compose).

# ---- Secrets: generated, 256 random bits each (ADR 0007 §4) ----------------
# hss provisioning API tokens: operator, acs, ft-server.
HSS_ADMIN_TOKEN=
HSS_ACS_TOKEN=
HSS_FT_TOKEN=
# pcscf's token for msrp-relay's control API (rcs-sim plays pcscf for now).
RELAY_PCSCF_TOKEN=
# acs admin API token.
ACS_ADMIN_TOKEN=
# ft-server's Digest nonce key.
FT_NONCE_KEY=
# Key of the log hints of identifiers (internal/pii).
RCS_PII_HMAC_KEY=
# hss data key, base64 of 32 bytes: the dev keyring path in place of KMS.
HSS_DATA_KEY=

# ---- Names --------------------------------------------------------------
# The IMS domain is fixed in the compose file, ims.mnc001.mcc001.3gppnetwork.org:
# acs 1.4.0 derives it from the test IMSI's MCC and MNC, so it is not a
# setting here.
FT_REALM=ft.ims.mnc001.mcc001.3gppnetwork.org
# What clients are told. The defaults are the compose network's names, which
# make e2e-compose uses; docs/local-stack.md explains when to change them.
FT_PUBLIC_BASE=http://ft-server:8081
RELAY_PUBLIC_HOST=msrp-relay
PCSCF_PUBLIC_HOST=pcscf
ACS_PUBLIC_BASE=http://acs:8080

# ---- Host ports (127.0.0.1 only) -----------------------------------------
ACS_HOST_PORT=18080
FT_HOST_PORT=18081
HSS_API_HOST_PORT=18082
RELAY_CONTROL_HOST_PORT=18083
RELAY_MSRP_HOST_PORT=12855
DYNAMODB_HOST_PORT=18000
S3_HOST_PORT=19090

RCS_LOG_LEVEL=info
